# Exemple d'environnement pour ClapIA-Video

# Clé Fal.ai (obligatoire)
FAL_KEY=your_fal_api_key_here

# Modèle vidéo utilisé (par défaut fal-ai/veo3.1)
VIDEO_MODEL=fal-ai/veo3.1

# Clé AshnaAI (obligatoire pour /api/enhance — Account → API sur app.ashna.ai)
ASHNA_API_KEY=your_ashna_api_key_here

# Base URL de l'API AshnaAI (défaut : https://api.ashna.ai/v1/api)
# ASHNA_API_URL=https://api.ashna.ai/v1/api

# Modèle AshnaAI pour l'amélioration de prompt (défaut : gpt-4o-mini)
# ASHNA_MODEL=gpt-4o-mini

# Redis (optionnel mais recommandé)
REDIS_URL=redis://localhost:6379

# JWT secret (obligatoire en production)
JWT_SECRET=change_this_secret

# Crédits initial et coût par génération (valeurs par défaut pour le demo)
STARTING_CREDITS=20
COST_PER_VIDEO=5
